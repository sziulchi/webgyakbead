<%- include("partials/header") %>

<section class="post">
    <h1>Üzenetek</h1>

    <div class="table-wrapper">
        <table class="alt">
            <thead>
                <tr>
                    <th>Küldés ideje</th>
                    <th>Név</th>
                    <th>E-mail</th>
                    <th>Üzenet</th>
                </tr>
            </thead>
            <tbody>
                <% uzenetek.forEach(u => { %>
                <tr>
                    <td><%= u.createdAt.toLocaleString("hu-HU", { timeZone: "Europe/Budapest" }) %></td>
                    <td><%= u.nev %></td>
                    <td><%= u.email %></td>
                    <td><%= u.uzenet %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>

<%- include("partials/footer") %>