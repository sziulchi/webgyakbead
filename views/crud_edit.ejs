<%- include("partials/header") %>

<section class="post">

    <h1>Sütemény szerkesztése</h1>

    <form method="post" action="/crud/update">
        <input type="hidden" name="id" value="<%= suti._id %>">

            <label for="nev">Név</label>
            <input type="text" name="nev" id="nev" value="<%= suti.nev %>">

            <label for="tipus">Típus</label>
            <input type="text" name="tipus" id="tipus" value="<%= suti.tipus %>">

            <label for="dijazott">Díjazott</label>
            <select name="dijazott" id="dijazott">
                <option value="0" <%= suti.dijazott == 0 ? "selected" : "" %>>Nem</option>
                <option value="-1" <%= suti.dijazott == -1 ? "selected" : "" %>>Igen</option>
            </select>

       <input type="submit" value="Mentés" class="primary">
    </form>
</section>

<%- include("partials/footer") %>