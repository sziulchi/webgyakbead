<%- include("partials/header") %>

<section class="post">
<div class="table-wrapper">
<table class="alt">
    <thead>
        <tr>
            <th>Név</th>
            <th>Típus</th>
            <th>Díjazott</th>
            <th>Árak</th>
            <th>Egység</th>
            <th>Mentes</th>
        </tr>
    </thead>

    <tbody>
        <% sutik.forEach(s => { %>
            <tr>
                <td><%= s.nev %></td>
                <td><%= s.tipus %></td>
                <td><%= s.dijazott %></td>
                <td><% arak.filter(a => a.sutiid == s.id).forEach(a => { %> 
                    <%= a.ertek %>Ft
                <% }) %></td>
                <td><% arak.filter(a => a.sutiid == s.id).forEach(a => { %> 
                    <%= a.egyseg %>
                <% }) %></td>
                <td><% tartalmak.filter(t => t.sutiid == s.id).forEach(t => { %>
                    <%= t.mentes %>
                <% }) %></td>
            </tr>
        <% }) %>
    </tbody>

</table>
</div>
</section>

<%- include("partials/footer") %>